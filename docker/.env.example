NGINX_UPSTREAM_HOST=__PRODUCT___web
NGINX_UPSTREAM_PORT=5000
NGINX_HTTP_HOST_PORT=80
NGINX_HTTPS_HOST_PORT=443
NGINX_SERVER_NAME=localhost
NGINX_FEATURE_HOST_DIR=__FEATURE_HOST_DIR__
# CIDRs of the proxies allowed to set X-Forwarded-Proto and
# X-Forwarded-Host. Empty trusts no peer, which is the safe default. Set it
# only behind a TLS terminator on the host, for example 172.16.0.0/12.
NGINX_TRUSTED_PROXY_CIDRS=
